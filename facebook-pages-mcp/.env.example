# Never commit a real access token.
FACEBOOK_PAGE_ACCESS_TOKEN=replace-at-runtime

# Comma-separated numeric Page IDs. Every Graph API call is restricted to this list.
FACEBOOK_PAGE_IDS=123456789012345

# Optional settings.
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_PREVIEW_TTL_SECONDS=900
FACEBOOK_REQUEST_TIMEOUT_MS=15000
FACEBOOK_MAX_MESSAGE_CHARS=20000
