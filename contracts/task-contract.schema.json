{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MTEnt/speshul-skills/contracts/task-contract.schema.json",
  "title": "TaskContract",
  "description": "Shared shape for the acceptance contract, task anchor, and budget that speshul-skills packages derive before substantive work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_type", "outcome", "acceptance_checks", "stop_condition"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "task_type": {
      "type": "string",
      "enum": ["defect", "incident", "feature", "refactor", "review", "research", "mixed"]
    },
    "outcome": {"type": "string", "minLength": 1},
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "baseline": {"type": "string"},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "surface": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "stop_condition": {"type": "string", "minLength": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "confidence", "expected_range", "checkpoint"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 10},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "expected_range": {"type": "string", "description": "Expected active-work completion range, for example 20-60m."},
        "checkpoint": {"type": "string", "description": "Elapsed active time without progress that triggers reassessment, for example 15m."}
      }
    }
  }
}
